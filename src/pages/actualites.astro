---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import articles from '../data/actualites.json';

const tries = [...articles].sort((a, b) => b.date.localeCompare(a.date));
const annees = [...new Set(tries.map((a) => a.date.slice(0, 4)))].sort((a, b) => b.localeCompare(a));

const formate = (iso) =>
  new Date(iso).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

// `vignette` est une version 400x400 générée pour la grille : les cartes
// tiraient sinon des JPEG de 1400 px dans des cases de 256 px, soit 20 Mo
// pour parcourir la liste. On retombe sur l'image d'origine si elle manque.
const vignette = (article) =>
  article.vignette || article.images?.[0] || article.videoThumbs?.[0] || null;

const PAS = 18;
const articlesInitiaux = tries.slice(0, PAS);
const resumes = tries.map((article) => ({
  slug: article.slug,
  titre: article.titre,
  date: article.date,
  extrait: article.extrait,
  vignette: vignette(article),
  video: Boolean(article.videoThumbs?.length),
}));
const resumesJson = JSON.stringify(resumes).replace(/</g, '\\u003c');
---
<Base
  title="Actualités – CDSBF77"
  description="Les actualités de la savate en Seine-et-Marne : résultats, stages, vie des clubs et du comité."
>
  <section class="bandeau">
    <svg class="trajectoire" viewBox="0 0 1200 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="trace-or trace-anime" d="M-50 330 C 260 330, 380 90, 700 90 S 1150 260, 1300 190" />
      <circle class="impact" cx="700" cy="90" r="4" />
    </svg>
    <div class="enveloppe">
      <p class="surtitre">Actualités</p>
      <h1>La vie du comité</h1>
      <p class="accroche">
        {tries.length} publications : résultats, stages, vie des clubs et portraits de celles et ceux qui
        font vivre la savate en Seine-et-Marne.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="enveloppe">
      <div class="filtres">
        <label class="champ">
          <span class="champ-icone"><Icone nom="recherche" taille="1.05rem" /></span>
          <input id="recherche" type="search" placeholder="Rechercher un article…" aria-label="Rechercher un article" />
        </label>
        <label class="champ champ--select">
          <select id="annee" aria-label="Filtrer par année">
            <option value="">Toutes les années</option>
            {annees.map((a) => <option value={a}>{a}</option>)}
          </select>
        </label>
      </div>

      <p id="compteur" class="compteur" aria-live="polite" hidden></p>

      <div class="grille-articles" id="liste-articles">
        {articlesInitiaux.map((article) => (
          <article
            class="carte"
            data-texte={(article.titre + ' ' + article.extrait).toLowerCase()}
            data-annee={article.date.slice(0, 4)}
          >
            <a class="carte-lien" href={'/actualites/' + article.slug}>
              <span class="sr-only">Lire : {article.titre}</span>
            </a>

            <div class:list={['carte-media', { 'carte-media--vide': !vignette(article) }]}>
              {vignette(article) ? (
                <img src={vignette(article)} alt="" loading="lazy" decoding="async" width="480" height="480" />
              ) : (
                <span aria-hidden="true">CDSBF 77</span>
              )}
              {article.videoThumbs?.length > 0 && (
                <span class="pastille-video" aria-hidden="true"><Icone nom="lecture" taille="1.6rem" /></span>
              )}
            </div>

            <div class="carte-corps">
              <p class="carte-date">
                <Icone nom="calendrier" taille="0.85rem" /> {formate(article.date)}
              </p>
              <h2 class="carte-titre">{article.titre}</h2>
              <p class="carte-extrait">{article.extrait}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="suite-articles">
        <button id="charger-suite" class="bouton bouton--ligne-sombre" type="button">
          Afficher 18 articles de plus
        </button>
      </div>

      <p id="aucun" hidden class="vide">
        Aucun article ne correspond. Essayez un autre mot-clé, ou remettez l'année sur « Toutes ».
      </p>
    </div>
  </section>

  <script is:inline id="donnees-actualites" type="application/json" set:html={resumesJson}></script>

  <script>
    type ResumeActualite = {
      slug: string;
      titre: string;
      date: string;
      extrait: string;
      vignette: string | null;
      video: boolean;
    };

    const PAS = 18;

    function initialiserActualites() {
      const liste = document.getElementById('liste-articles');
      const recherche = document.getElementById('recherche') as HTMLInputElement | null;
      const annee = document.getElementById('annee') as HTMLSelectElement | null;
      const aucun = document.getElementById('aucun');
      const compteur = document.getElementById('compteur');
      const chargeur = document.getElementById('charger-suite') as HTMLButtonElement | null;
      const source = document.getElementById('donnees-actualites');
      if (!liste || !recherche || !annee || !aucun || !compteur || !chargeur || !source || liste.dataset.pret === 'oui') return;

      const articles = JSON.parse(source.textContent || '[]') as ResumeActualite[];
      const carteInitiale = liste.querySelector('.carte');
      const attributPortee = carteInitiale
        ? Array.from(carteInitiale.attributes).find((attribut) => attribut.name.startsWith('data-astro-cid-'))?.name
        : undefined;
      let limite = PAS;

      const formater = (iso: string) => new Date(iso + 'T12:00:00').toLocaleDateString('fr-FR', {
        day: 'numeric', month: 'long', year: 'numeric'
      });

      function creerCarte(article: ResumeActualite) {
        const carte = document.createElement('article');
        carte.className = 'carte';

        const lien = document.createElement('a');
        lien.className = 'carte-lien';
        lien.href = '/actualites/' + article.slug;
        const acces = document.createElement('span');
        acces.className = 'sr-only';
        acces.textContent = 'Lire : ' + article.titre;
        lien.append(acces);

        const media = document.createElement('div');
        media.className = article.vignette ? 'carte-media' : 'carte-media carte-media--vide';
        if (article.vignette) {
          const image = document.createElement('img');
          image.src = article.vignette;
          image.alt = '';
          image.loading = 'lazy';
          image.decoding = 'async';
          image.width = 480;
          image.height = 480;
          media.append(image);
        } else {
          const marque = document.createElement('span');
          marque.textContent = 'CDSBF 77';
          marque.setAttribute('aria-hidden', 'true');
          media.append(marque);
        }
        if (article.video) {
          const video = document.createElement('span');
          video.className = 'pastille-video';
          video.setAttribute('aria-hidden', 'true');
          video.textContent = '▶';
          media.append(video);
        }

        const corps = document.createElement('div');
        corps.className = 'carte-corps';
        const date = document.createElement('p');
        date.className = 'carte-date';
        date.textContent = formater(article.date);
        const titre = document.createElement('h2');
        titre.className = 'carte-titre';
        titre.textContent = article.titre;
        const extrait = document.createElement('p');
        extrait.className = 'carte-extrait';
        extrait.textContent = article.extrait;
        corps.append(date, titre, extrait);
        carte.append(lien, media, corps);

        // Les styles de cette page sont isolés par Astro au moyen d'un
        // attribut de portée. Les cartes créées après coup doivent recevoir
        // ce même attribut pour conserver exactement le rendu serveur.
        if (attributPortee) {
          carte.setAttribute(attributPortee, '');
          carte.querySelectorAll('*').forEach((element) => element.setAttribute(attributPortee, ''));
        }
        return carte;
      }

      function afficher() {
        const q = recherche.value.trim().toLowerCase();
        const a = annee.value;
        const filtreActif = q !== '' || a !== '';
        const resultats = articles.filter((article) => {
          const texte = (article.titre + ' ' + article.extrait).toLowerCase();
          return (!q || texte.includes(q)) && (!a || article.date.startsWith(a));
        });
        const visibles = filtreActif ? resultats : resultats.slice(0, limite);
        liste.replaceChildren(...visibles.map(creerCarte));

        aucun.hidden = resultats.length > 0;
        compteur.hidden = !filtreActif || resultats.length === 0;
        compteur.textContent = resultats.length > 1
          ? resultats.length + ' articles trouvés'
          : resultats.length + ' article trouvé';

        chargeur.hidden = filtreActif || limite >= articles.length;
        const restants = Math.min(PAS, articles.length - limite);
        chargeur.textContent = 'Afficher ' + restants + (restants > 1 ? ' articles' : ' article') + ' de plus';
      }

      recherche.addEventListener('input', afficher);
      annee.addEventListener('change', afficher);
      chargeur.addEventListener('click', () => {
        limite = Math.min(limite + PAS, articles.length);
        afficher();
      });
      liste.dataset.pret = 'oui';
      afficher();
    }

    initialiserActualites();
    document.addEventListener('astro:page-load', initialiserActualites);
  </script>
</Base>

<style>
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  /* ---------- Filtres ---------- */
  .filtres { display: flex; flex-wrap: wrap; gap: 0.8rem; margin: 0 0 2rem; }
  .champ {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex: 1 1 18rem;
    background: var(--blanc);
    border: 1px solid var(--gris-200);
    border-radius: 2px;
    padding: 0 1rem;
    transition: border-color 0.2s ease;
  }
  .champ:focus-within { border-color: var(--bleu-700); }
  .champ-icone { color: var(--gris-500); display: flex; }
  .champ input,
  .champ select {
    flex: 1;
    font-family: var(--police-texte);
    font-size: 1rem;
    padding: 0.85rem 0;
    border: 0;
    background: transparent;
    color: var(--encre);
  }
  .champ input:focus, .champ select:focus { outline: none; }
  .champ--select { flex: 0 1 12rem; }

  .compteur {
    margin: -1rem 0 1.4rem;
    font-size: var(--txt-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--or-texte);
  }

  .vide { color: var(--gris-500); padding: 2rem 0; }

  /* ---------- Grille des articles ---------- */
  .grille-articles {
    display: grid;
    gap: 1px;
    background: var(--gris-200);
    border: 1px solid var(--gris-200);
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .carte {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--blanc);
    transition: background 0.25s ease;
  }
  .carte:hover, .carte:focus-within { background: #fbfcfd; }
  .carte-lien { position: absolute; inset: 0; z-index: 1; }
  .carte-lien:focus-visible { outline: 3px solid var(--or-400); outline-offset: -3px; }

  .carte-media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--craie);
    overflow: hidden;
  }
  .carte-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.5s var(--sortie); }
  .carte:hover .carte-media img { transform: scale(1.04); }
  .carte-media--vide {
    display: grid;
    place-items: end start;
    padding: 1.25rem;
    background:
      radial-gradient(circle at 78% 24%, var(--or-400) 0 4px, transparent 5px),
      linear-gradient(145deg, transparent 0 48%, rgba(212, 175, 55, 0.35) 48.3% 48.8%, transparent 49.1%),
      linear-gradient(135deg, var(--bleu-900), var(--bleu-700));
  }
  .carte-media--vide > span {
    font-family: var(--police-titre);
    font-size: clamp(2rem, 4vw, 3.3rem);
    letter-spacing: 0.04em;
    color: var(--blanc);
  }
  .pastille-video {
    position: absolute;
    top: 0.7rem;
    right: 0.7rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: rgba(8, 25, 46, 0.55);
    color: var(--blanc);
    backdrop-filter: blur(2px);
  }

  .carte-corps { padding: 1.3rem 1.4rem 1.5rem; display: flex; flex-direction: column; gap: 0.5rem; flex: 1; }
  .carte-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--txt-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--or-texte);
    margin: 0;
  }
  .carte-titre {
    font-family: var(--police-titre);
    font-size: 1.3rem;
    letter-spacing: 0.02em;
    line-height: 1.15;
    color: var(--bleu-900);
    margin: 0;
  }
  .carte-extrait {
    font-size: var(--txt-sm);
    line-height: 1.6;
    color: var(--gris-500);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .suite-articles { display: flex; justify-content: center; padding: 2rem 0 0; }
  .bouton--ligne-sombre {
    color: var(--bleu-900);
    border-color: var(--bleu-700);
    background: transparent;
    cursor: pointer;
  }
  .bouton--ligne-sombre:hover { color: var(--blanc); background: var(--bleu-700); transform: translateY(-2px); }

  @media (min-width: 900px) {
    .grille-articles .carte:first-child {
      grid-column: span 2;
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    }
    .grille-articles .carte:first-child .carte-media { aspect-ratio: auto; min-height: 20rem; }
    .grille-articles .carte:first-child .carte-corps { justify-content: end; padding: 1.8rem; }
    .grille-articles .carte:first-child .carte-titre { font-size: clamp(1.65rem, 2.4vw, 2.25rem); }
  }

  @media (max-width: 600px) {
    .filtres { display: grid; grid-template-columns: 1fr; gap: 0.7rem; }
    .filtres .champ,
    .filtres .champ--select {
      width: 100%;
      min-height: 3.45rem;
      flex: none;
    }
  }
</style>
