---
import '../styles/accueil.css';
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import donnees from '../data/clubs.json';
import formation from '../data/formation.json';
import savateAdaptee from '../data/savate-adaptee.json';
import articles from '../data/actualites.json';

const nbClubs = donnees.clubs.length;
const nbLecons = formation.lecons.length + savateAdaptee.lecons.length;

const actualitesRecentes = [...articles]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 4);
const [vedette, ...autresActualites] = actualitesRecentes;
const vignetteActualite = (article) =>
  article.vignette || article.images?.[0] || article.videoThumbs?.[0] || null;
const dateActualite = (iso) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const disciplines = [
  { icone: 'boxe', nom: 'Savate boxe française', teinte: 'var(--gant-bleu)',
    texte: "Pieds chaussés, poings gantés. L'assaut où seule la touche compte, le combat pour les confirmés." },
  { icone: 'canne', nom: 'Canne de combat', teinte: 'var(--gant-vert)',
    texte: "L'escrime française à la canne de châtaignier : vitesse, précision, élégance." },
  { icone: 'forme', nom: 'Savate forme', teinte: 'var(--gant-jaune)',
    texte: 'Les enchaînements pieds-poings en séance de fitness, en musique, sans opposition.' },
  { icone: 'defense', nom: 'Savate défense', teinte: 'var(--gant-rouge)',
    texte: 'Évaluer, se dégager, riposter. Des repères, de la lucidité, de la confiance.' },
];

const activites = [
  { icone: 'formation', nom: 'Se former', action: 'Voir les formations', lien: '/formations',
    texte: `Moniteur fédéral, officiels, savate adaptée. ${nbLecons} leçons en ligne, en accès libre, chacune close par un quiz.` },
  { icone: 'competition', nom: 'Compétitions', action: 'Voir le calendrier', lien: '/competitions',
    texte: 'Championnats et challenges départementaux, du jeune tireur au tireur confirmé.' },
  { icone: 'developpement', nom: 'Développement', action: 'Découvrir les actions', lien: '/developpement',
    texte: 'Aller-vers, sport-santé, milieu scolaire, insertion : la savate hors les murs.' },
];

// Logos des partenaires, tous hébergés dans le site.
// `fondSombre` sert aux logos dessinés en blanc, invisibles sur fond clair.
const partenaires = [
  { nom: 'Ligue Île-de-France de Savate', court: 'Ligue Île-de-France', logo: '/logos/partenaires/ligue-idf.png' },
  { nom: 'Fédération Française de Savate', court: 'FF Savate', logo: '/logos/partenaires/ff-savate.png' },
  { nom: 'Département de Seine-et-Marne', court: 'Département 77', logo: '/logos/partenaires/departement-77.png', fondSombre: true },
  { nom: 'Agence Nationale du Sport', court: 'Agence Nationale du Sport', logo: '/logos/partenaires/agence-nationale-du-sport.png' },
  { nom: 'SDJES 77', court: 'SDJES 77', logo: '/logos/partenaires/sdjes-77.png' },
  { nom: 'DRAJES et FDVA', court: 'DRAJES · FDVA', logo: '/logos/partenaires/drajes-fdva.png' },
];
---
<Base>
  <div class="accueil">
    <section class="hero" aria-labelledby="hero-title">
      <svg class="hero-trajectory" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path class="trajectory-gold" d="M-50 560 C 250 560, 380 120, 700 120 S 1150 420, 1300 300"></path>
        <path class="trajectory-pale" d="M-50 620 C 300 620, 420 200, 760 200 S 1180 480, 1300 360"></path>
        <circle class="trajectory-impact" cx="700" cy="120" r="5"></circle>
      </svg>

      <div class="site-container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow eyebrow--light"><span></span>Comité de Seine-et-Marne</p>
          <h1 id="hero-title">L'escrime<br><em>des pieds</em><br>et des poings</h1>
          <p class="hero-intro">{nbClubs} clubs, quatre disciplines. De la découverte à la compétition, la savate se vit partout en Seine-et-Marne.</p>
          <div class="hero-actions">
            <a class="button button--gold" href="/clubs">
              Trouver mon club
              <Icone nom="fleche-droite" taille="1rem" />
            </a>
            <a class="button button--outline" href="/disciplines">Voir les disciplines</a>
          </div>
        </div>

        <figure class="hero-media">
          <div class="media-topline" aria-hidden="true">
            <span>CDSBF 77</span>
            <span>La savate en mouvement</span>
          </div>
          <div class="video-shell">
            <div class="video-frame">
              <div class="video-poster" aria-hidden="true">
                <span class="poster-number" aria-hidden="true">77</span>
                <strong>CDSBF 77</strong>
                <span>La savate en mouvement</span>
              </div>
              <iframe tabindex="-1" data-video="https://player.vimeo.com/video/1072779716?h=fe9825216e&background=1&autoplay=1&loop=1&byline=0&title=0&muted=1" allow="autoplay; fullscreen; picture-in-picture" title="La savate en Seine-et-Marne" loading="lazy"></iframe>
            </div>
          </div>
          <figcaption>
            <span aria-hidden="true"></span>Tourné dans les clubs du département
            <a href="https://vimeo.com/1072779716/fe9825216e">Voir la vidéo sur Vimeo</a>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="stats" aria-label="Le comité en chiffres">
      <div class="site-container stats-grid">
        <a href="/clubs" class="stat">
          <strong>{nbClubs}</strong>
          <span>clubs affiliés</span>
          <Icone nom="fleche-droite" taille="1rem" />
        </a>
        <a href="/disciplines" class="stat">
          <strong>4</strong>
          <span>disciplines</span>
          <Icone nom="fleche-droite" taille="1rem" />
        </a>
        <a href="/formations" class="stat">
          <strong>{nbLecons}</strong>
          <span>leçons en ligne</span>
          <Icone nom="fleche-droite" taille="1rem" />
        </a>
      </div>
    </section>

    <section class="section disciplines" id="disciplines" aria-labelledby="disciplines-title">
      <div class="site-container">
        <div class="section-heading section-heading--intro">
          <div>
            <p class="eyebrow eyebrow--light"><span></span>Disciplines</p>
            <h2 id="disciplines-title">Quatre façons de pratiquer</h2>
          </div>
          <p class="section-intro">La savate boxe française est le cœur de la pratique. Autour d'elle, trois disciplines associées permettent à chacun de trouver sa forme.</p>
        </div>

        <div class="discipline-grid">
          {disciplines.map(({ icone, nom, texte, teinte }, index) => (
            <a class="discipline-card" href="/disciplines" style={"--accent: " + teinte}>
              <span class="card-number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <span class="discipline-icon"><Icone nom={icone} taille="1.5rem" /></span>
              <h3>{nom}</h3>
              <p>{texte}</p>
              <span class="card-link">Découvrir la discipline <Icone nom="fleche-droite" taille="1rem" /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section committee" aria-labelledby="committee-title">
      <div class="site-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span></span>Le rôle du comité</p>
            <h2 id="committee-title">Former, organiser, aller vers</h2>
          </div>
        </div>

        <div class="committee-grid">
          {activites.map(({ icone, nom, texte, lien, action }) => (
            <a class="committee-card" href={lien}>
              <span class="committee-icon"><Icone nom={icone} taille="1.5rem" /></span>
              <div>
                <h3>{nom}</h3>
                <p>{texte}</p>
                <span class="card-link">{action} <Icone nom="fleche-droite" taille="1rem" /></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="photo-band" aria-labelledby="band-title">
      <img class="photo-band-image" src="/images/actualites/2026-06-08-avec-babekus-xv-plus-de-30-personnes-de/video-1-thumb-vignette.jpg" alt="" loading="lazy" decoding="async">
      <div class="site-container photo-band-inner">
        <div class="photo-band-copy">
          <p class="eyebrow eyebrow--light"><span></span>Dans les clubs</p>
          <h2 id="band-title">De la découverte à la compétition</h2>
          <p>{nbClubs} clubs accueillent les tireurs de tous âges en Seine-et-Marne, de l'initiation aux championnats.</p>
          <a class="button button--gold" href="/clubs">
            Trouver mon club
            <Icone nom="fleche-droite" taille="1rem" />
          </a>
        </div>
        <div class="photo-band-figure" aria-hidden="true">
          <strong>77</strong>
          <span>Seine-et-Marne</span>
        </div>
      </div>
    </section>

    <section class="section news" aria-labelledby="news-title">
      <div class="site-container">
        <div class="section-heading">
          <div>
            <p class="eyebrow"><span></span>En ce moment</p>
            <h2 id="news-title">La vie du comité</h2>
          </div>
          <a class="text-link" href="/actualites">
            Toutes les actualités
            <Icone nom="fleche-droite" taille="1rem" />
          </a>
        </div>

        {vedette && (
          <div class="news-grid">
            <a class="news-feature" href={'/actualites/' + vedette.slug}>
              <div class="news-feature-visual">
                <span class="news-watermark" aria-hidden="true">77</span>
                {vignetteActualite(vedette) && (
                  <img src={vignetteActualite(vedette)} alt="" loading="lazy" decoding="async" width="640" height="640" />
                )}
                <span class="news-label">Actualité du comité</span>
              </div>
              <div class="news-feature-body">
                <time datetime={vedette.date}>{dateActualite(vedette.date)}</time>
                <h3>{vedette.titre}</h3>
                <p>{vedette.extrait}</p>
                <span class="card-link">Lire l’actualité <Icone nom="fleche-droite" taille="1rem" /></span>
              </div>
            </a>

            <div class="news-list">
              {autresActualites.map((article) => (
                <a class="news-item" href={'/actualites/' + article.slug}>
                  <span class="news-thumb">
                    <span class="image-fallback" aria-hidden="true">77</span>
                    {vignetteActualite(article) && (
                      <img src={vignetteActualite(article)} alt="" loading="lazy" decoding="async" width="640" height="640" />
                    )}
                  </span>
                  <div class="news-item-body">
                    <time datetime={article.date}>{dateActualite(article.date)}</time>
                    <h3>{article.titre}</h3>
                    <span class="news-read">Lire l’actualité <Icone nom="fleche-droite" taille="1rem" /></span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>

    <section class="partners" aria-labelledby="partners-title">
      <div class="site-container partners-inner">
        <h2 class="partners-title" id="partners-title">Ils soutiennent la savate<br>en Seine-et-Marne</h2>
        <ul class="partners-list">
          {partenaires.map(({ nom, court, logo, fondSombre }) => (
            <li class:list={['partner', { 'partner--dark': fondSombre }]}>
              <img src={logo} alt={nom} loading="lazy" decoding="async"
                   onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
              <span class="partner-fallback" hidden>{court}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="contact-strip" aria-labelledby="contact-title">
      <div class="site-container contact-strip-inner">
        <div>
          <p class="eyebrow"><span></span>Contact</p>
          <h2 id="contact-title">Une question sur la pratique ?</h2>
          <p>Écrivez au comité pour être orienté vers le bon interlocuteur.</p>
        </div>
        <a class="button button--navy" href="mailto:cdsbf77@gmail.com">
          Écrire au comité
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>
        </a>
      </div>
    </section>
  </div>
</Base>

<script>
  document.addEventListener('astro:page-load', () => {
    const hero = document.querySelector('.accueil .hero');
    const trajectoire = hero?.querySelector('.hero-trajectory');
    const video = hero?.querySelector<HTMLIFrameElement>('iframe[data-video]');
    const sobre = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (trajectoire && !sobre) {
      trajectoire.querySelectorAll('path').forEach((trace) => {
        trace.style.setProperty('--longueur', String(Math.ceil(trace.getTotalLength())));
      });
      requestAnimationFrame(() => trajectoire.classList.add('is-drawing'));
    }

    if (!video?.dataset.video || video.hasAttribute('src')) return;
    if (sobre) {
      video.hidden = true;
      return;
    }

    video.addEventListener('load', () => {
      video.parentElement?.classList.add('is-loaded');
    }, { once: true });
    video.src = video.dataset.video;
  });
</script>
