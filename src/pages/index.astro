---
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import donnees from '../data/clubs.json';
import formation from '../data/formation.json';
import savateAdaptee from '../data/savate-adaptee.json';
import articles from '../data/actualites.json';
import donneesSecteurs from '../data/secteurs.json';

const nbClubs = donnees.clubs.length;
const nbLecons = formation.lecons.length + savateAdaptee.lecons.length;

const actualitesRecentes = [...articles]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 4);
const vignetteActualite = (article) =>
  article.vignette || article.images?.[0] || article.videoThumbs?.[0] || null;
const dateActualite = (iso) =>
  new Date(iso + 'T12:00:00').toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });

const positions: Record<string, { x: number; y: number }> = {
  meaux: { x: 51, y: 13 },
  'marne-la-vallee': { x: 23, y: 31 },
  coulommiers: { x: 62, y: 35 },
  ozoir: { x: 18, y: 51 },
  melun: { x: 40, y: 68 },
  fontainebleau: { x: 58, y: 84 },
};
const libellesClubs: Record<string, string> = {
  meaux: 'CS Meaux',
  collegien: 'Collégien',
  dampmart: 'Dampmart',
  serris: 'SVES',
  rebais: 'Rebais',
  'fontenay-tresigny': 'Fontenay-Trésigny',
  roissy: 'Roissy',
  avon: 'Avon',
};
const bassins = donneesSecteurs.secteurs.map((secteur) => ({
  ...secteur,
  ...positions[secteur.slug],
  clubsEnVue: secteur.misEnAvant.map((slug) => libellesClubs[slug] || slug),
}));

// La progression technique fédérale : le système d'accent du site.
// Les phrases-profils viennent du module 1.3c de l'espace formation.
const gants = [
  { nom: 'Bleu', variable: '--gant-bleu', profil: 'Je touche' },
  { nom: 'Vert', variable: '--gant-vert', profil: 'Je ne suis pas touché, et je touche' },
  { nom: 'Rouge', variable: '--gant-rouge', profil: 'Décalage, débordement' },
  { nom: 'Blanc', variable: '--gant-blanc', profil: 'Contres et contre-attaques' },
  { nom: 'Jaune', variable: '--gant-jaune', profil: 'Feinter, perturber' },
  { nom: 'Argent', variable: '--gant-argent', profil: 'Expertise technique' },
];

const disciplines = [
  { icone: 'boxe', nom: 'Savate boxe française', teinte: 'var(--gant-bleu)',
    texte: "Pieds chaussés, poings gantés. L'assaut où seule la touche compte, le combat pour les confirmés." },
  { icone: 'canne', nom: 'Canne de combat', teinte: 'var(--gant-vert)',
    texte: "L'escrime française à la canne de châtaignier : vitesse, précision, élégance." },
  { icone: 'forme', nom: 'Savate forme', teinte: 'var(--gant-jaune)',
    texte: 'Les enchaînements pieds-poings en séance de fitness, en musique, sans opposition.' },
  { icone: 'defense', nom: 'Savate défense', teinte: 'var(--gant-rouge)',
    texte: 'Évaluer, se dégager, riposter. Des repères, de la lucidité, de la confiance.' },
];

const activites = [
  { icone: 'formation', nom: 'Se former', lien: '/formations', teinte: 'var(--gant-bleu)',
    texte: `Moniteur fédéral, officiels, savate adaptée. ${nbLecons} leçons en ligne, en accès libre, chacune close par un quiz.` },
  { icone: 'competition', nom: 'Compétitions', lien: '/competitions', teinte: 'var(--gant-rouge)',
    texte: 'Championnats et challenges départementaux, du jeune tireur au tireur confirmé.' },
  { icone: 'developpement', nom: 'Développement', lien: '/developpement', teinte: 'var(--gant-vert)',
    texte: 'Aller-vers, sport-santé, milieu scolaire, insertion : la savate hors les murs.' },
];

// Logos des partenaires, tous hébergés dans le site.
// `fondSombre` sert aux logos dessinés en blanc, invisibles sur fond clair.
const partenaires = [
  { nom: 'Ligue Île-de-France de Savate', court: 'Ligue Île-de-France', logo: '/logos/partenaires/ligue-idf.png' },
  { nom: 'Fédération Française de Savate', court: 'FF Savate', logo: '/logos/partenaires/ff-savate.png' },
  { nom: 'Département de Seine-et-Marne', court: 'Département 77', logo: '/logos/partenaires/departement-77.png', fondSombre: true },
  { nom: 'Agence Nationale du Sport', court: 'Agence Nationale du Sport', logo: '/logos/partenaires/agence-nationale-du-sport.png' },
  { nom: 'SDJES 77', court: 'SDJES 77', logo: '/logos/partenaires/sdjes-77.png' },
  { nom: 'DRAJES et FDVA', court: 'DRAJES · FDVA', logo: '/logos/partenaires/drajes-fdva.png' },
];
---
<Base>
  <!-- ================= HÉROS ================= -->
  <section class="heros">
    <svg class="trajectoire" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <path class="trace-or trace-anime" d="M-50 560 C 250 560, 380 120, 700 120 S 1150 420, 1300 300" />
      <path class="trace-pale trace-anime" d="M-50 620 C 300 620, 420 200, 760 200 S 1180 480, 1300 360" />
      <circle class="impact" cx="700" cy="120" r="4" />
    </svg>

    <div class="heros-grille">
      <div class="heros-texte">
        <p class="surtitre">Comité de Seine-et-Marne</p>
        <h1>L'escrime<br /><em>des pieds</em><br />et des poings</h1>
        <p class="accroche">
          {nbClubs} clubs, quatre disciplines. Une progression qui se lit à la
          couleur du gant, du premier assaut à la transmission.
        </p>
        <div class="heros-actions">
          <a class="bouton bouton--plein" href="/clubs">Trouver mon club</a>
          <a class="bouton bouton--ligne" href="/disciplines">Voir les disciplines</a>
        </div>
      </div>

      <!-- La vidéo est au format portrait : assumée en panneau vertical -->
      <div class="heros-media">
        <div class="cadre-video">
          <div class="video-attente" aria-hidden="true">
            <strong>CDSBF 77</strong>
            <span>La savate en mouvement</span>
          </div>
          <iframe
            src="https://player.vimeo.com/video/1072779716?h=fe9825216e&background=1&autoplay=1&loop=1&byline=0&title=0&muted=1"
            allow="autoplay; fullscreen; picture-in-picture"
            title="La savate en Seine-et-Marne" loading="eager"
            onload="this.parentElement.classList.add('charge')"></iframe>
        </div>
        <p class="legende">Tourné dans les clubs du département</p>
      </div>
    </div>
  </section>

  <!-- ================= L'ÉCHELLE DES GANTS ================= -->
  <section class="section section--sombre" id="progression">
    <div class="enveloppe">
      <p class="surtitre">La progression fédérale</p>
      <h2 class="titre-section">Six gants, six façons de tirer</h2>
      <p class="intro">
        En savate, le niveau se lit à la couleur du gant. Chaque grade tient en
        une phrase : ce qu'on sait faire, pas ce qu'on a gagné.
      </p>

      <ol class="echelle">
        {gants.map((g) => (
          <li class="gant" style={`--gant: var(${g.variable})`}>
            <span class="gant-pastille"></span>
            <span class="gant-nom">{g.nom}</span>
            <span class="gant-profil">« {g.profil} »</span>
          </li>
        ))}
      </ol>

      <p class="echelle-pied">
        Avant le gant bleu, les plus jeunes passent les grades Kangourou.
        Après le jaune viennent les Gants d'Argent Technique.
        <a href="/formations/monitorat">Comprendre la progression</a>
      </p>
    </div>
  </section>

  <!-- ================= DISCIPLINES ================= -->
  <section class="section" id="disciplines">
    <div class="enveloppe">
      <p class="surtitre">Disciplines</p>
      <h2 class="titre-section">Quatre façons de pratiquer</h2>
      <p class="intro">
        La savate boxe française est le cœur de la pratique. Autour d'elle, trois
        disciplines associées permettent à chacun de trouver sa forme.
      </p>
    </div>
    <div class="enveloppe">
      <div class="grille-filet">
        {disciplines.map((d) => (
          <a class="carte" href="/disciplines" style={`--teinte: ${d.teinte}`}>
            <span class="carte-icone"><Icone nom={d.icone} taille="1.6rem" /></span>
            <h3>{d.nom}</h3>
            <p>{d.texte}</p>
            <span class="carte-fleche"><Icone nom="fleche-droite" taille="1.1rem" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= TOUR DU 77 ================= -->
  <section class="section territoire" id="tour-du-77">
    <div class="enveloppe territoire-entete">
      <div>
        <p class="surtitre">La savate près de chez vous</p>
        <h2 class="titre-section">Le Tour du 77</h2>
      </div>
      <p class="intro">
        Six bassins, {nbClubs} clubs et autant de portes d'entrée. Choisissez
        votre territoire pour retrouver directement les clubs les plus proches.
      </p>
    </div>

    <div class="enveloppe">
      <div class="territoire-plan">
        <svg class="territoire-dessin" viewBox="0 0 700 720" aria-hidden="true">
          <path class="territoire-contour" d="M290 34 L462 74 L531 155 L641 236 L590 347 L624 467 L520 548 L482 680 L327 646 L236 568 L112 518 L89 394 L144 293 L123 188 L214 129 Z" />
          <path class="territoire-trace" d="M356 94 C258 145 174 208 173 350 S286 522 412 603" />
          <path class="territoire-trace territoire-trace--bis" d="M175 350 C294 316 394 244 493 246 S572 332 529 423" />
        </svg>

        <ol class="bassins">
          {bassins.map((bassin, index) => (
            <li style={`--x:${bassin.x}%; --y:${bassin.y}%`}>
              <a href={'/clubs/autour-de-' + bassin.slug}>
                <span class="bassin-numero">0{index + 1}</span>
                <span class="bassin-texte">
                  <strong>{bassin.nom}</strong>
                  <small>
                    {bassin.clubsEnVue.length
                      ? bassin.clubsEnVue.join(' · ')
                      : bassin.clubs.length + ' clubs à découvrir'}
                  </small>
                </span>
                <span class="bassin-fleche"><Icone nom="fleche-droite" taille="1rem" /></span>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <p class="territoire-pied">
        <span>Vous préférez parcourir tout l'annuaire ?</span>
        <a href="/clubs">Voir les {nbClubs} clubs</a>
      </p>
    </div>
  </section>

  <!-- ================= CHIFFRES ================= -->
  <section class="section section--craie">
    <div class="enveloppe">
      <div class="chiffres">
        <div class="chiffre"><strong>{nbClubs}</strong><span>clubs affiliés</span></div>
        <div class="chiffre"><strong>4</strong><span>disciplines</span></div>
        <div class="chiffre"><strong>{nbLecons}</strong><span>leçons en ligne</span></div>
        <div class="chiffre"><strong>6</strong><span>gants à gravir</span></div>
      </div>
    </div>
  </section>

  <!-- ================= ACTIVITÉS ================= -->
  <section class="section">
    <div class="enveloppe">
      <p class="surtitre">Le rôle du comité</p>
      <h2 class="titre-section">Former, organiser, aller vers</h2>
    </div>
    <div class="enveloppe">
      <div class="grille-filet">
        {activites.map((a) => (
          <a class="carte" href={a.lien} style={`--teinte: ${a.teinte}`}>
            <span class="carte-icone"><Icone nom={a.icone} taille="1.6rem" /></span>
            <h3>{a.nom}</h3>
            <p>{a.texte}</p>
            <span class="carte-fleche"><Icone nom="fleche-droite" taille="1.1rem" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= ACTUALITÉS ================= -->
  <section class="section actualites-accueil">
    <div class="enveloppe actualites-entete">
      <div>
        <p class="surtitre">En ce moment</p>
        <h2 class="titre-section">La vie du comité</h2>
      </div>
      <a class="lien-tout" href="/actualites">Toutes les actualités <Icone nom="fleche-droite" taille="1rem" /></a>
    </div>

    <div class="enveloppe">
      <div class="actualites-grille">
        {actualitesRecentes.map((article, index) => (
          <a class:list={['actu-accueil', { 'actu-accueil--vedette': index === 0 }]} href={'/actualites/' + article.slug}>
            <span class:list={['actu-visuel', { 'actu-visuel--vide': !vignetteActualite(article) }]}>
              {vignetteActualite(article) ? (
                <img src={vignetteActualite(article)} alt="" loading="lazy" decoding="async" width="640" height="640" />
              ) : (
                <span class="actu-marque" aria-hidden="true">CDSBF 77</span>
              )}
            </span>
            <span class="actu-corps">
              <span class="actu-date">{dateActualite(article.date)}</span>
              <strong>{article.titre}</strong>
              {index === 0 && <span class="actu-extrait">{article.extrait}</span>}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= PARTENAIRES ================= -->
  <section class="section section--craie">
    <div class="enveloppe">
      <p class="surtitre">Ils soutiennent la savate en Seine-et-Marne</p>
      <div class="partenaires">
        {partenaires.map((p) => (
          <div class:list={['partenaire', { 'partenaire--sombre': p.fondSombre }]}>
            <img src={p.logo} alt={p.nom} loading="lazy" decoding="async"
                 onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
            <span class="partenaire-nom" hidden>{p.court}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Héros ---------- */
  .heros {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #0b2748 0%, var(--bleu-900) 45%, #123f74 100%);
    padding: clamp(7rem, 14vw, 10rem) 0 clamp(4rem, 8vw, 6rem);
  }
  .heros-grille {
    position: relative;
    z-index: 1;
    max-width: var(--large);
    margin: 0 auto;
    padding: 0 clamp(1.2rem, 5vw, 3rem);
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    align-items: center;
  }
  .heros :global(.surtitre) { color: var(--or-400); }
  .heros h1 {
    font-family: var(--police-titre);
    font-size: var(--titre-xl);
    line-height: 0.92;
    letter-spacing: 0.01em;
    color: var(--blanc);
    margin: 0 0 1.4rem;
  }
  .heros h1 em { font-style: normal; color: var(--or-400); }
  .accroche {
    color: #c3cedb;
    font-size: var(--txt-md);
    line-height: 1.65;
    max-width: 42ch;
    margin: 0 0 2rem;
  }
  .heros-actions { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  .heros-media { display: flex; flex-direction: column; gap: 0.7rem; }
  .cadre-video {
    position: relative;
    aspect-ratio: 9 / 14;
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45);
    background: linear-gradient(145deg, #081d36, var(--bleu-700));
  }
  .video-attente {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.15rem;
    padding: 1.5rem;
    background:
      radial-gradient(circle at 78% 22%, var(--or-400) 0 5px, transparent 6px),
      linear-gradient(145deg, transparent 0 47%, rgba(212, 175, 55, 0.38) 47.2% 47.65%, transparent 47.9%),
      linear-gradient(160deg, #081d36, var(--bleu-700));
    color: var(--blanc);
  }
  .video-attente strong {
    font-family: var(--police-titre);
    font-size: clamp(2.4rem, 5vw, 4.5rem);
    letter-spacing: 0.04em;
    line-height: 0.95;
  }
  .video-attente span {
    color: #c3cedb;
    font-size: var(--txt-xs);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  /* Le lecteur Vimeo ajoute des bandes noires pour préserver le format :
     on agrandit légèrement l'iframe pour que l'image couvre le cadre. */
  .cadre-video iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    transform: scale(1.18);
    transform-origin: center;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .cadre-video.charge iframe { opacity: 1; }
  .legende {
    margin: 0;
    font-size: var(--txt-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9aa8ba;
  }

  /* ---------- Pied de l'échelle ---------- */
  .echelle-pied {
    margin: 1.8rem 0 0;
    font-size: 0.9rem;
    color: #a8b6c8;
    max-width: 62ch;
  }
  .echelle-pied a { color: var(--or-400); }

  /* ---------- Tour du 77 ---------- */
  .territoire {
    background: linear-gradient(155deg, #071a31, var(--bleu-900));
    color: var(--blanc);
    overflow: hidden;
  }
  .territoire-entete {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 1.2fr);
    align-items: end;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .territoire .titre-section { color: var(--blanc); }
  .territoire .intro { margin: 0; color: #b8c6d7; }
  .territoire-plan {
    position: relative;
    min-height: 43rem;
    margin-top: 2.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.13);
    border-bottom: 1px solid rgba(255, 255, 255, 0.13);
    background: radial-gradient(circle at 50% 48%, rgba(26, 78, 140, 0.34), transparent 55%);
  }
  .territoire-dessin {
    position: absolute;
    inset: 0;
    width: min(100%, 44rem);
    height: 100%;
    margin: auto;
  }
  .territoire-contour {
    fill: rgba(255, 255, 255, 0.025);
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.5;
  }
  .territoire-trace {
    fill: none;
    stroke: var(--or-400);
    stroke-width: 2;
    stroke-dasharray: 7 11;
    animation: territoire-defile 10s linear infinite;
  }
  .territoire-trace--bis { stroke: rgba(129, 170, 218, 0.7); animation-duration: 14s; }
  @keyframes territoire-defile { to { stroke-dashoffset: -180; } }

  .bassins { list-style: none; margin: 0; padding: 0; }
  .bassins li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    z-index: 2;
  }
  .bassins a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: clamp(12rem, 20vw, 15.5rem);
    padding: 0.8rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(8, 29, 54, 0.88);
    color: var(--blanc);
    text-decoration: none;
    box-shadow: 0 14px 28px rgba(0, 0, 0, 0.22);
    backdrop-filter: blur(12px);
    transition: transform 0.25s var(--sortie), border-color 0.25s ease, background 0.25s ease;
  }
  .bassins a:hover,
  .bassins a:focus-visible {
    transform: translateY(-4px);
    border-color: var(--or-400);
    background: rgba(15, 52, 96, 0.98);
  }
  .bassins a:focus-visible { outline: 3px solid var(--or-400); outline-offset: 3px; }
  .bassin-numero {
    color: var(--or-400);
    font-family: var(--police-titre);
    font-size: 1.35rem;
  }
  .bassin-texte { display: flex; flex: 1; min-width: 0; flex-direction: column; }
  .bassin-texte strong { font-family: var(--police-titre); font-size: 1.35rem; letter-spacing: 0.03em; line-height: 1; }
  .bassin-texte small { margin-top: 0.25rem; color: #aebed1; font-size: 0.68rem; line-height: 1.35; }
  .bassin-fleche { display: inline-flex; color: var(--or-400); }
  .territoire-pied {
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    margin: 1.5rem 0 0;
    color: #9fb0c5;
    font-size: var(--txt-sm);
  }
  .territoire-pied a { color: var(--or-400); font-weight: 700; }

  /* ---------- Actualités sur l'accueil ---------- */
  .actualites-entete {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2rem;
  }
  .lien-tout {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--bleu-700);
    font-weight: 700;
    text-decoration: none;
  }
  .lien-tout:hover { color: var(--or-texte); }
  .lien-tout:focus-visible { outline: 3px solid var(--or-400); outline-offset: 4px; }
  .actualites-grille {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
    gap: 1px;
    border: 1px solid var(--gris-200);
    background: var(--gris-200);
  }
  .actu-accueil {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    min-height: 9.5rem;
    background: var(--blanc);
    color: var(--encre);
    text-decoration: none;
    overflow: hidden;
    transition: background 0.25s ease;
  }
  .actu-accueil--vedette {
    grid-row: span 3;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(18rem, 1fr) auto;
  }
  .actu-visuel { display: block; min-width: 0; overflow: hidden; background: var(--craie); }
  .actu-visuel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.55s var(--sortie);
  }
  .actu-visuel--vide {
    display: flex;
    align-items: end;
    padding: 1.4rem;
    background:
      radial-gradient(circle at 78% 22%, var(--or-400) 0 5px, transparent 6px),
      linear-gradient(145deg, transparent 0 48%, rgba(212, 175, 55, 0.34) 48.2% 48.7%, transparent 49%),
