---
import '../styles/polices.css';
import '../styles/comite.css';
import '../styles/composants.css';
import '../styles/interface.css';
import { ClientRouter } from 'astro:transitions';
import Icone from '../components/Icone.astro';

const {
  title = 'CDSBF77 – Savate boxe française en Seine-et-Marne',
  description = 'Le Comité Départemental de Savate Boxe Française de Seine-et-Marne : annuaire des clubs, disciplines, compétitions et formations.',
  image = '/og-cdsbf77.png',
  noindex = false,
} = Astro.props;

const urlImage = new URL(image, Astro.site);

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/clubs', label: 'Clubs' },
  { href: '/disciplines', label: 'Disciplines' },
  { href: '/competitions', label: 'Compétitions' },
  { href: '/formations', label: 'Formations' },
  { href: '/developpement', label: 'Développement' },
  { href: '/actualites', label: 'Actualités' },
  { href: '/contact', label: 'Contact' },
];
const chemin = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0b2744" />
    <meta property="og:site_name" content="CDSBF77" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:image" content={urlImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Comité Départemental de Savate Boxe Française de Seine-et-Marne" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={urlImage} />
    <noscript><style>.card { opacity: 1 !important; transform: none !important; }
      .anim-cascade > * { opacity: 1 !important; transform: none !important; }</style></noscript>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <header class="site-header" id="navigation">
      <div class="site-container nav-wrap">
        <a class="brand" href="/" aria-label="CDSBF 77 — Accueil">
          <span class="brand-monogram" aria-hidden="true">77</span>
          <span class="brand-name">CDSBF<small>Savate boxe française</small></span>
        </a>

        <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="menu-principal">
          <span>Menu</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path class="menu-line menu-line--top" d="M4 7h16"></path>
            <path class="menu-line menu-line--middle" d="M4 12h16"></path>
            <path class="menu-line menu-line--bottom" d="M4 17h16"></path>
          </svg>
        </button>

        <nav class="main-nav" id="menu-principal" aria-label="Navigation principale">
          {nav.map(({ href, label }) => (
            <a href={href} aria-current={chemin === href || (href !== "/" && chemin.startsWith(href + "/")) ? "page" : undefined}>{label}</a>
          ))}
          <a class="nav-mobile-cta" href="/clubs">Trouver mon club</a>
        </nav>

        <a class="nav-cta" href="/clubs">
          Trouver un club
          <Icone nom="fleche-droite" taille="1rem" />
        </a>
      </div>
    </header>

    <main id="contenu" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="site-container footer-main">
        <div class="footer-identity">
          <img src="/logos/cdsbf77.png" alt="Logo CDSBF77" width="100" height="100" loading="lazy" decoding="async">
          <div>
            <strong>CDSBF 77</strong>
            <p>Comité Départemental de Savate Boxe Française de Seine-et-Marne</p>
          </div>
        </div>

        <div class="footer-contact">
          <span>Nous contacter</span>
          <a href="mailto:cdsbf77@gmail.com">cdsbf77@gmail.com</a>
          <div class="site-socials">
            <a href="https://www.facebook.com/profile.php?id=100088440284322" aria-label="Facebook" rel="noopener">
              <Icone nom="facebook" taille="1.2rem" />
            </a>
            <a href="https://www.instagram.com/comite_77_savate_bf/" aria-label="Instagram" rel="noopener">
              <Icone nom="instagram" taille="1.2rem" />
            </a>
            <a href="mailto:cdsbf77@gmail.com" aria-label="Courriel">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect></svg>
            </a>
          </div>
        </div>
      </div>

      <div class="site-container footer-bottom">
        <p>© {new Date().getFullYear()} - Comité Départemental de Savate Boxe Française de Seine-et-Marne</p>
        <nav aria-label="Liens de pied de page">
          <a href="/liens">Liens utiles</a>
          <a href="/comite">Le comité</a>
          <a href="/mentions-legales">Mentions légales</a>
        </nav>
      </div>
    </footer>

    <button class="back-to-top" type="button" aria-label="Retour en haut de la page">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m18 15-6-6-6 6"></path></svg>
    </button>

    <script>
      const sobre = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const tactile = () => window.matchMedia('(hover: none), (pointer: coarse)').matches;

      // Les trajectoires se dessinent à l'arrivée dans le champ.
      // Elles remplacent les particules flottantes : le mouvement dit
      // quelque chose de la savate au lieu d'être un décor générique.
      function trajectoires() {
        const svgs = document.querySelectorAll('.trajectoire');
        if (!svgs.length) return;
        if (sobre()) { svgs.forEach((s) => s.classList.add('vue')); return; }

        const obs = new IntersectionObserver((entrees) => {
          entrees.forEach((e) => {
            if (!e.isIntersecting) return;
            e.target.querySelectorAll('.trace-anime').forEach((p) => {
              // La longueur exacte du tracé permet de le dérouler proprement
              p.style.setProperty('--longueur', String(Math.ceil(p.getTotalLength())));
            });
            e.target.classList.add('vue');
            obs.unobserve(e.target);
          });
        }, { threshold: 0.15 });
        svgs.forEach((s) => obs.observe(s));
      }

      function apparitions() {
        // Cartes pleine largeur
        const obsCartes = new IntersectionObserver((entrees) => {
          entrees.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('visible'); obsCartes.unobserve(e.target); } });
        }, { threshold: 0.1, rootMargin: '0px 0px -100px 0px' });
        document.querySelectorAll('.card').forEach((c) => obsCartes.observe(c));

        // Grilles : apparition en cascade, un enfant après l'autre
        const grilles = document.querySelectorAll('.features-grid, .info-grid, .clubs-grid, .club-galerie');
        const obsGrilles = new IntersectionObserver((entrees) => {
          entrees.forEach((e) => {
            if (!e.isIntersecting) return;
            Array.from(e.target.children).forEach((enfant) => enfant.classList.add('revele'));
            obsGrilles.unobserve(e.target);
          });
        }, { threshold: 0.15, rootMargin: '0px 0px -60px 0px' });
        grilles.forEach((g) => {
          g.classList.add('anim-cascade');
          Array.from(g.children).forEach((enfant, i) => enfant.style.setProperty('--i', String(i)));
          obsGrilles.observe(g);
        });
      }

      function logoClub() {
        if (sobre() || tactile()) return;
        const bandeau = document.querySelector('.club-scope .page-hero');
        const bloc = document.querySelector('.club-logo-bloc');
        if (!bandeau || !bloc) return;
        let trame = null;
        bandeau.addEventListener('pointermove', (ev) => {
          if (trame) return;
          trame = requestAnimationFrame(() => {
            trame = null;
            const r = bandeau.getBoundingClientRect();
            const x = (ev.clientX - r.left) / r.width - 0.5;
            const y = (ev.clientY - r.top) / r.height - 0.5;
            bloc.style.transform =
              'perspective(900px) rotateX(' + (-y * 12).toFixed(2) + 'deg) rotateY(' + (x * 12).toFixed(2) + 'deg)';
          });
        });
        bandeau.addEventListener('pointerleave', () => {
          if (trame) { cancelAnimationFrame(trame); trame = null; }
          bloc.style.transition = 'transform 0.6s cubic-bezier(0.22, 1.4, 0.36, 1)';
          bloc.style.transform = '';
          setTimeout(() => { bloc.style.transition = ''; }, 650);
        });
      }

      const desktop = window.matchMedia('(min-width: 1121px)');
      const miseAJourDefilement = () => {
        document.querySelector('.site-header')?.classList.toggle('scrolled', window.scrollY > 24);
        document.querySelector('.back-to-top')?.classList.toggle('is-visible', window.scrollY > 650);
      };
      window.addEventListener('scroll', miseAJourDefilement, { passive: true });

      let navigation: AbortController | undefined;
      function interfaceSite() {
        navigation?.abort();
        navigation = new AbortController();
        const options = { signal: navigation.signal };
        const header = document.querySelector('.site-header');
        const bouton = header?.querySelector<HTMLButtonElement>('.nav-toggle');
        const fermer = () => {
          header?.classList.remove('menu-open');
          document.body.classList.remove('menu-open');
          bouton?.setAttribute('aria-expanded', 'false');
        };
        fermer();
        document.documentElement.classList.add('js');
        bouton?.addEventListener('click', () => {
          const ouvert = header?.classList.toggle('menu-open') ?? false;
          document.body.classList.toggle('menu-open', ouvert);
          bouton.setAttribute('aria-expanded', String(ouvert));
        }, options);
        header?.querySelectorAll('.main-nav a').forEach((lien) => {
          lien.addEventListener('click', fermer, options);
        });
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || !header?.classList.contains('menu-open')) return;
          fermer();
          bouton?.focus();
        }, options);
        document.addEventListener('click', (event) => {
          if (event.target instanceof Node && !header?.contains(event.target)) fermer();
        }, options);
        desktop.addEventListener('change', fermer, options);

        document.querySelector('.back-to-top')?.addEventListener('click', () => {
          document.querySelector<HTMLElement>('.brand')?.focus({ preventScroll: true });
          window.scrollTo({ top: 0, behavior: sobre() ? 'instant' : 'smooth' });
        }, options);
        miseAJourDefilement();
      }

      function initialiser() {
        interfaceSite();
        if ('IntersectionObserver' in window) {
          trajectoires();
          apparitions();
        }
        logoClub();
      }

      // Se déclenche au premier chargement comme après chaque transition de page
      document.addEventListener('astro:before-swap', () => navigation?.abort());
      document.addEventListener('astro:page-load', initialiser);
    </script>
  </body>
</html>
